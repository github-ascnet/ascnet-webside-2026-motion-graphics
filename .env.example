# Vorlage für .env (lokal, nicht ins Git). Dieselben Namen als Variablen im
# Cloudflare-Pages-Projekt setzen (Typ Text), siehe docs/.

# Öffentlicher Mapbox-Token (pk.…), im Mapbox-Konto auf ascnet.ch beschränken
MAPBOX_TOKEN=

# Öffentlicher Turnstile Site Key (optional lokal, Test-Key als Fallback)
TURNSTILE_SITE_KEY=

